<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".infoActivity"
    android:background="@color/page_background"
    android:padding="24dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Before starting the test..."
        android:textSize="30sp"
        android:gravity="center"
        android:textColor="@color/brand_maroon"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@+id/startTest"
        app:layout_constraintTop_toBottomOf="@+id/header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/t2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="1. The test you have clicked will show questions one by one. You just have to click on the correct answer according to you."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/t3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="2. You will have 10 seconds to answer each question. After that, the next question will be displayed on the screen. You can see the timer for each question."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/t4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="3. If the answer clicked is correct, it will be highlighted in green. Otherwise, the clicked answer will turn red and the correct answer will be shown in green."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/t5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4. At the end of the test, you can see your score."
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/startTest"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="Start Test"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        app:backgroundTint="@color/brand_maroon"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>